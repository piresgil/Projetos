      //"apc.font.family": "JetBrainsMono Nerd Font",
      "apc.font.family": "JetBrains Mono",
      "apc.stylesheet": {
        //developer toggle tools
        ".glyph-margin": "width: 2px",
        ".title-label > h2": "display: none",
        ".editor-actions": "display: none",
        ".nosidebar .inline-tabs-placeholder": "width: 5px",
        ".pane-header": "padding: 0 1px",
        ".pane-body": "padding: 1px",
        ".split-view-view:first-child .pane-header": "display: none !important;",
