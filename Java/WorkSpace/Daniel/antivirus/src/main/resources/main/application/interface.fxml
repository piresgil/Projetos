<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.application.controller.Controller">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Botão para escolher a pasta -->
    <Button text="Análise de Ficheiros" onAction="#escolherDiretorioEAnalisar" />

    <TextField fx:id="urlTextField" promptText="Insira URL para base de dados" style="-fx-font-size: 14px;" />

    <!-- Botão para buscar a URL e carregar os dados -->
    <Button text="Procurar URL de Phishing" onAction="#buscarBaseDeDados" />

    <TextArea fx:id="consoleTextArea" layoutX="14.0" layoutY="300.0" prefHeight="200.0" prefWidth="600.0" />
</VBox>
